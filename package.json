{
  "name": "vipdid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "process:assets": "node scripts/process-assets.mjs",
    "prepare:seed": "node scripts/prepare-seed.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "pnpm process:assets && vite build",
    "build": "pnpm process:assets && vite build && node scripts/build-worker.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.1.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251004.0",
    "@types/node": "24.5.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.10",
    "sharp": "0.34.3",
    "typescript": "5.8.3",
    "wrangler": "4.39.0"
  }
}

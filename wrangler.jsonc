{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vipdid-platform",
  "main": "dist-worker/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vipdid-platform",
      "database_id": "be117780-1c27-46c2-8f6d-d3aa03bc09c0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vipdid-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "40fc6c20795c49a09e64b5a429511046"
    }
  ],
  "services": [
    {
      "binding": "MAILER",
      "service": "saudi-cv-email-failover",
      "entrypoint": "PlatformMailer"
    }
  ]
}

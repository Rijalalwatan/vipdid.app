{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vipdid-platform",
  "main": "dist-worker/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vipdid-platform",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vipdid-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "__KV_NAMESPACE_ID__"
    }
  ],
  "services": [
    {
      "binding": "MAILER",
      "service": "saudi-cv-email-failover",
      "entrypoint": "PlatformMailer"
    }
  ]
}
